+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { ClaudeProfileRouter, type ClaudeProfileRouterSettings } from './claude-profile-router'
+import type { ClaudeManagedAccount } from '../../../../shared/agent-accounts/managed-account-types'
+
+const account = (id: string): ClaudeManagedAccount => ({
+  id,
+  email: `${id}@example.test`,
+  managedAuthPath: '',
+  authMethod: 'subscription-oauth',
+  createdAt: 0,
+  updatedAt: 0,
+  lastAuthenticatedAt: 0
+})
+
+describe('ClaudeProfileRouter pinned terminal account', () => {
+  let dataRoot: string
+
+  beforeEach(() => {
+    dataRoot = mkdtempSync(join(tmpdir(), 'orca-plus-pinned-'))
+  })
+
+  afterEach(() => {
+    rmSync(dataRoot, { recursive: true, force: true })
+  })
+
+  const router = (settings: Partial<ClaudeProfileRouterSettings>) =>
+    new ClaudeProfileRouter({
+      dataRoot,
+      userHome: dataRoot,
+      env: {},
+      runSetup: async () => ({ outcome: 'refused', warnings: [] }) as never,
+      getSettings: () => ({
+        claudeManagedAccounts: [account('personal'), account('other')],
+        activeClaudeManagedAccountId: null,
+        activeClaudeManagedAccountIdsByRuntime: { host: null, wsl: {} },
+        agentStatusHooksEnabled: false,
+        disabledTuiAgents: [],
+        ...settings
+      })
+    })
+
+  it('gives a pinned pane the account folder without the injected marker', () => {
+    const env = router({}).terminalEnv({ runtime: 'host' }, 'personal')
+    expect(env).toEqual({
+      ORCA_CLAUDE_PROFILE_POINTER: join(dataRoot, 'claude-profiles', 'selected-host'),
+      CLAUDE_CONFIG_DIR: join(dataRoot, 'claude-profiles', 'personal', 'home')
+    })
+  })
+
+  it('keeps the pin when another account is selected', () => {
+    const env = router({
+      activeClaudeManagedAccountIdsByRuntime: { host: 'other', wsl: {} }
+    }).terminalEnv({ runtime: 'host' }, 'personal')
+    expect(env.CLAUDE_CONFIG_DIR).toBe(join(dataRoot, 'claude-profiles', 'personal', 'home'))
+    expect(env.ORCA_CLAUDE_INJECTED_CONFIG_DIR).toBeUndefined()
+  })
+
+  it('ignores a pin that names no saved account', () => {
+    const env = router({}).terminalEnv({ runtime: 'host' }, 'missing')
+    expect(env.CLAUDE_CONFIG_DIR).toBeUndefined()
+  })
+})
