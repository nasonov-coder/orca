@@ -0,0 +1,40 @@
+import { useMemo } from 'react'
+import { useAppStateValue } from '@/store/retained-views/app-state-view'
+import { AgentIcon } from '@/components/agent/icons/AgentIcon'
+import type { AgentPickerChoice } from '../agent-picker-search-rows'
+import type { AgentPickerMenuLaunch } from '../AgentLaunchPickerMenuRow'
+import type { NewTabAgentMenuModel } from './new-tab-agent-menu-model'
+
+/** Orca Plus: one terminal launch per saved Claude account other than the selected one. */
+export function useClaudeAccountLaunchChoices(
+  model: NewTabAgentMenuModel,
+  runLaunch: AgentPickerMenuLaunch
+): AgentPickerChoice[] {
+  const accounts = useAppStateValue((state) => state.settings?.claudeManagedAccounts)
+  const selectedId = useAppStateValue(
+    (state) =>
+      state.settings?.activeClaudeManagedAccountIdsByRuntime?.host ??
+      state.settings?.activeClaudeManagedAccountId ??
+      null
+  )
+  const claudeRunsHere =
+    model.state === 'settled' &&
+    (model.detection.detectedIds?.includes('claude') ?? false) &&
+    model.rows.some((row) => row.agent === 'claude' && (row.executionHostId ?? 'local') === 'local')
+  return useMemo(
+    () =>
+      claudeRunsHere
+        ? (accounts ?? [])
+            .filter((account) => account.id !== selectedId && account.managedAuthRuntime !== 'wsl')
+            .map((account) => ({
+              id: `claude-account:${account.id}`,
+              label: `Claude · ${account.email}`,
+              icon: <AgentIcon agent="claude" size={14} />,
+              onSelect: () => {
+                void runLaunch({ kind: 'cli', agent: 'claude', claudeAccountId: account.id })
+              }
+            }))
+        : [],
+    [accounts, claudeRunsHere, runLaunch, selectedId]
+  )
+}
